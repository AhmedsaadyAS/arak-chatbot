# ── Arak Chatbot Environment Variables ──────────────────────────

# Backend API URL
ARAK_API_URL=http://localhost:5000/api

# JWT secret (must match the .NET backend's JWT signing key)
JWT_SECRET_KEY=change-me-in-env

# ── AI Layer Configuration ──────────────────────────────────────

# Google Gemini API key (get one free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Enable/disable each AI layer (true/false)
ENABLE_GEMINI_LITE=true
ENABLE_GEMINI_FLASH=true
ENABLE_OLLAMA=true
ENABLE_SKLEARN=true

# Model names (can be overridden per-request from dashboard)
GEMINI_LITE_MODEL=gemini-2.0-flash-lite
GEMINI_FLASH_MODEL=gemini-1.5-flash
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434

# Cache TTL in seconds (same prompt within this window skips all layers)
CACHE_TTL=60
